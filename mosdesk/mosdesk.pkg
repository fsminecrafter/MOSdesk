[Info]
name=mosdesk
version=0.2.0
description=Layered Minimal-OS desktop environment
arch=x86_64
operatingsystem=MINIMALOS

# No copy= list: everything in the package installs below 0:/ -
#   programs/mosdesk/...      the Settings app, libraries and fonts
#   programs/mos_<app>.run    the built-in apps from mosdesk/apps
[Install.minimalos]
target=0:/
